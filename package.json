{
    "name": "@mat3ra/pyodide-repl",
    "version": "0.0.0",
    "description": "A Python REPL for the browser: Pyodide session management, editor UI, and an embeddable page that talks to its host over the mat3ra iframe data bridge.",
    "scripts": {
        "lint": "eslint src tests && prettier --write src tests",
        "lint:fix": "eslint --fix --cache src tests && prettier --write src tests",
        "transpile": "tsc",
        "prettier": "prettier --check src tests",
        "prepare": "husky install",
        "prepublishOnly": "npm run transpile",
        "test:unit": "tsx --test tests/*.tests.ts",
        "test": "npm run lint && npm run transpile && npm run test:unit",
        "provision-wheels": "node scripts/provision-wheels.mjs",
        "predev": "npm run provision-wheels",
        "dev": "vite",
        "prebuild": "npm run provision-wheels",
        "build": "vite build"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mat3ra/pyodide-repl.git"
    },
    "main": "dist/index.js",
    "files": [
        "dist",
        "src",
        "LICENSE.md",
        "README.md"
    ],
    "license": "Apache-2.0",
    "peerDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mat3ra/cove": "*",
        "@mui/icons-material": "^5.16.14",
        "@mui/material": "^5.16.14",
        "react": "^17.0.2",
        "react-dom": "^17.0.2"
    },
    "devDependencies": {
        "@codemirror/autocomplete": "^6.18.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@exabyte-io/eslint-config": "2025.5.13-0",
        "@mat3ra/cove": "2026.8.19-4",
        "@mat3ra/esse": "2026.8.18-2",
        "@mui/icons-material": "^5.16.14",
        "@mui/material": "^5.16.14",
        "@types/react": "^17.0.2",
        "@types/react-dom": "^17.0.2",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "8.57.0",
        "husky": "^9.1.7",
        "prettier": "^2.7.1",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vite": "^5.4.11"
    }
}
